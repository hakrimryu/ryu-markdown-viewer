/node_modules/
/.vite/
/.cache/
*.tsbuildinfo

# Generated app builds and GitHub Release assets (EXE, ZIP, etc.)
/dist/
/release/

# Temporary test workspaces, reports, and generated screenshots
/.test-data/
/_workspace/
/artifacts/
/coverage/
